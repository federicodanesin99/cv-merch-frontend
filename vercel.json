{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd cv-store-frontend && npm install && npm run build",
  "outputDirectory": "cv-store-frontend/dist/cv-store-frontend/browser",
  "installCommand": "cd cv-store-frontend && npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
