{
  "name": "cv-store-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.7.0",

  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:cv-store-frontend": "node dist/cv-store-frontend/server/server.mjs",
    "build": "ng build --configuration production",
    "vercel-build": "ng build --configuration production"
  },

  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },

  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.0",

    "@angular/fire": "^20.0.1",
    "firebase": "^10.0.0",

    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },

  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",

    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",

    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",

    "jsdom": "^27.1.0",
    "vitest": "^3.2.4",

    "typescript": "~5.8.0"
  }
}
